{
  "name": "bare-wdk-runtime",
  "version": "1.7.0",
  "description": "The runtime modules to make the deps of WDK run",
  "dependencies": {
    "abort-controller": "^3.0.0",
    "bare-assert": "^1.0.2",
    "bare-buffer": "^3.2.0",
    "bare-crypto": "^1.5.1",
    "bare-encoding": "^1.0.0",
    "bare-events": "^2.5.4",
    "bare-fetch": "^2.3.1",
    "bare-fs": "^4.1.6",
    "bare-http1": "^4.0.2",
    "bare-https": "^2.0.0",
    "bare-path": "^3.0.0",
    "bare-process": "^4.2.1",
    "bare-stream": "^2.6.5",
    "bare-tcp": "^2.0.5",
    "bare-tls": "^2.0.6",
    "bare-tty": "^5.0.2",
    "bare-url": "^2.1.6",
    "bare-utils": "^1.2.1",
    "bare-zlib": "^1.3.0",
    "event-target-shim": "^5.0.1"
  },
  "imports": {
    "node-fetch": {
      "bare": "bare-fetch",
      "default": "node-fetch"
    },
    "assert": {
      "bare": "bare-assert",
      "default": "assert"
    },
    "node:assert": {
      "bare": "bare-assert",
      "default": "node:assert"
    },
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "node:events": {
      "bare": "bare-events",
      "default": "node:events"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "node:fs": {
      "bare": "bare-fs",
      "default": "node:fs"
    },
    "buffer": {
      "bare": "bare-buffer",
      "default": "buffer"
    },
    "node:buffer": {
      "bare": "bare-buffer",
      "default": "node:buffer"
    },
    "http": {
      "bare": "bare-http1",
      "default": "http"
    },
    "node:http": {
      "bare": "bare-http1",
      "default": "node:http"
    },
    "net": {
      "bare": "bare-tcp",
      "default": "net"
    },
    "node:net": {
      "bare": "bare-tcp",
      "default": "node:net"
    },
    "util": {
      "bare": "bare-utils",
      "default": "util"
    },
    "node:util": {
      "bare": "bare-utils",
      "default": "node:util"
    },
    "crypto": {
      "bare": "bare-crypto",
      "default": "crypto"
    },
    "node:crypto": {
      "bare": "bare-crypto",
      "default": "node:crypto"
    },
    "https": {
      "bare": "bare-https",
      "default": "https"
    },
    "node:https": {
      "bare": "bare-https",
      "default": "node:https"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "node:path": {
      "bare": "bare-path",
      "default": "node:path"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    },
    "node:process": {
      "bare": "bare-process",
      "default": "node:process"
    },
    "stream": {
      "bare": "bare-stream",
      "default": "stream"
    },
    "node:stream": {
      "bare": "bare-stream",
      "default": "node:stream"
    },
    "tls": {
      "bare": "bare-tls",
      "default": "tls"
    },
    "node:tls": {
      "bare": "bare-tls",
      "default": "node:tls"
    },
    "tty": {
      "bare": "bare-tty",
      "default": "tty"
    },
    "node:tty": {
      "bare": "bare-tty",
      "default": "node:tty"
    },
    "url": {
      "bare": "bare-url",
      "default": "url"
    },
    "node:url": {
      "bare": "bare-url",
      "default": "node:url"
    },
    "zlib": {
      "bare": "bare-zlib",
      "default": "zlib"
    },
    "node:zlib": {
      "bare": "bare-zlib",
      "default": "node:zlib"
    }
  },
  "exports": {
    ".": {
      "bare": "./bare.js",
      "default": "./empty.js"
    },
    "./package": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/bare-wdk-runtime.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-wdk-runtime/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-wdk-runtime"
}
